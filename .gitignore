# Python bytecode / caches
__pycache__/
*.py[cod]

# Runtime logs
*.log

# Local credentials - never commit real keys
.env
.env.*

# Generated pricing reports
*_Live_Dashboard_*.csv
*_RMS_Manager_View_*.csv

# Everything the tool writes at run time: reports, logs, archive/
output/

# Local timezone preference (written by the staff UI)
timezone_settings.json
timezone_settings.json.tmp

# Local regression baseline. Tracked on purpose: the frozen reports are the
# behavioural specification the contracts check against, and the manifests hold
# only SHA-256 digests, never local paths. Generated reports elsewhere stay
# ignored (see the patterns above), so the baseline reports are re-included here
# explicitly.
!golden/
!golden/v0/reports/*.csv
!golden/v7/reports/*.csv

# Agent / assistant working data and chat logs - never commit
# (also enforced machine-wide via the global core.excludesfile)
.workbuddy/
.codebuddy/
.claude/
.cursor/
.windsurf/
.continue/
.aider*/
.agent/
.kiro/
agent-logs/
agent_logs/
workbuddy.md
codebuddy.md
chat-history*.md
chat_history*.md
conversation-log*.md
conversation_log*.md
